# BrickScan backend environment.
#   cp backend/.env.example backend/.env   and fill in real values.
# Every var WITHOUT a default in app/core/config.py is REQUIRED — the app
# raises on startup if it's missing. Those are marked [REQUIRED] below.
# Vars consumed directly via os.environ (not in Settings) are marked [optional].

# ── Datastores [REQUIRED] ─────────────────────────────────────────────────────
# In docker-compose these are overridden to point at the db/redis services;
# set real values here for a non-compose / managed-DB deploy. URL-encode any
# special chars in the password (@ : / ? # → %40 %3A ...).
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/brickscan
REDIS_URL=redis://localhost:6379/0

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# [REQUIRED] Generate a strong random value, e.g.  openssl rand -hex 32
# NEVER ship the placeholder to production — it signs every access token.
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256                  # [optional] default HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30   # [optional] default 30; no refresh token exists yet

# ── Third-party recognition / catalog APIs ───────────────────────────────────
# [REQUIRED by config] These have NO defaults in Settings, so the app will not
# boot unless they are present — even empty strings satisfy the type, but the
# corresponding feature is dead without a real key. GEMINI_API_KEY powers the
# Gemini fallback tier of the recognition cascade.
REBRICKABLE_API_KEY=your-rebrickable-api-key
BRICKLINK_CONSUMER_KEY=your-bricklink-consumer-key
BRICKLINK_CONSUMER_SECRET=your-bricklink-consumer-secret
BRICKLINK_TOKEN=your-bricklink-token
BRICKLINK_TOKEN_SECRET=your-bricklink-token-secret
GEMINI_API_KEY=your-gemini-api-key

# ── Model serving (in-container onnxruntime CPU) ──────────────────────────────
# Legacy EfficientNet classifier bundle (committed under backend/models/).
# NOTE: config.py default is lego_classifier.onnx — keep these in sync.
ML_MODEL_PATH=/app/models/lego_classifier.onnx          # [optional] default same
# [optional] "dinov2" or "efficientnet"; auto-detected from export_info.json if blank.
ML_MODEL_TYPE=
CONFIDENCE_THRESHOLD=0.75                                # [optional] default 0.75

# Student-retrieval tier (the validated 90.1% top-1 engine).
# student.onnx (86 MB) is NOT in git and the default path points into mobile/,
# which is absent from a backend-only deploy — so in prod you MUST set these to
# wherever the artifacts were provisioned (see scripts/provision_artifacts.sh).
# If unset/missing the tier silently disables (cascade still works via the APIs).
STUDENT_ONNX_PATH=/artifacts/student.onnx               # [optional but needed in prod]
STUDENT_GALLERY_PATH=/artifacts/gallery_index.json      # [optional but needed in prod]

# ── Web / CORS ────────────────────────────────────────────────────────────────
# [optional] Comma-separated allowed origins. REQUIRED in practice for prod:
# if blank, the app falls back to localhost-only CORS (see main.py) and a
# hosted client cannot call the API. e.g. https://app.brickscan.example
CORS_ALLOWED_ORIGINS=

# ── Recognition cascade feature flags ─────────────────────────────────────────
# [optional] All read via os.environ in app/services/hybrid_recognition.py.
# Defaults shown; flip to true to A/B. SCAN_STUDENT_RETRIEVAL_ENABLED defaults
# ON; the rest default OFF (Brickognize + Gemini-on-uncertainty is the baseline).
SCAN_STUDENT_RETRIEVAL_ENABLED=true
SCAN_TTA_ENABLED=false
SCAN_ALWAYS_RUN_GEMINI=false
SCAN_GROUNDED_GEMINI=false
SCAN_COLLAPSE_VARIANTS=false
SCAN_COLOR_RERANK=false
SCAN_USE_CALIBRATION=false

# ── S3 scan-image storage (CONFIGURED BUT NOT WIRED — see DEPLOY.md punch list) ──
# [REQUIRED by config] S3_BUCKET / AWS_* have no defaults so they must be present,
# but image_service.save_scan_image_to_s3 is never called with a live client and
# boto3 isn't even installed. Leave as placeholders until S3 is actually wired.
S3_BUCKET=brickscan-images
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ── Process / serving (read by Dockerfile.prod / gunicorn) ────────────────────
# [optional] Keep at 1 until scan_jobs.py is moved to Redis (in-process SSE job
# registry breaks across workers). See DEPLOY.md.
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120
